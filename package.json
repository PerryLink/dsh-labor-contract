{
  "name": "dsh-labor-contract",
  "version": "0.1.0-alpha.1",
  "description": "Review a labor contract's required clauses, probation cap and probation pay ratio; batch-check contract dates and export an issue list. Local only, not legal advice.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "TROUBLESHOOTING.md",
    "samples",
    "docs/assets",
    "screenshots.json",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/labor-contract.txt",
      "prompt": "帮我核对这份劳动合同的必备条款、试用期上限和试用期工资比例，再把 6 名员工的合同批量查一遍到期和试用期问题。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户指定的劳动合同文本与员工合同 CSV（样例：samples/quickstart/input/）"
      ],
      "writes": [
        "$DSH_HOME/dsh-labor-contract/exports/"
      ],
      "network": false,
      "external": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "gate": "node scripts/gate.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "quickstart": "node samples/quickstart/run.mjs --check",
    "prepublishOnly": "npm run build && node scripts/lint.mjs && node scripts/gate.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "labor",
    "contract",
    "hr",
    "probation",
    "compliance",
    "perrylink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-labor-contract.git"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-labor-contract/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
